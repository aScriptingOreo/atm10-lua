{
  "RS_ItemToRedstone": {
    "desc": "Redstone out while an RS item is at/below a count",
    "deps": [
      "cn_lib"
    ],
    "config": [
      {
        "key": "Item",
        "prompt": "Item id to watch",
        "default": "minecraft:soul_sand"
      },
      {
        "key": "Threshold",
        "prompt": "Signal on when count is at or below",
        "default": "16384"
      },
      {
        "key": "OutSide",
        "prompt": "Redstone output side",
        "default": "back"
      }
    ],
    "files": [
      "programs/RS_ItemToRedstone.lua"
    ],
    "main": "programs/RS_ItemToRedstone.lua"
  },
  "RS_Trash": {
    "desc": "Trash RS items above a keep count, or whole tags (list in RS_Trash.json)",
    "deps": [
      "cn_lib"
    ],
    "config": [
      {
        "key": "ExportDir",
        "prompt": "Bridge side facing the trash",
        "default": "down"
      }
    ],
    "files": [
      "programs/RS_Trash.lua",
      "programs/RS_Trash.json"
    ],
    "main": "programs/RS_Trash.lua"
  },
  "cn_lib": {
    "desc": "shared config helper (auto-installed as a dependency)",
    "files": [
      "lib/cn.lua"
    ]
  },
  "cookienet": {
    "desc": "this package manager (self-updates)",
    "files": [
      "cookienet.lua",
      "startup/cn.lua"
    ]
  },
  "reactor_rs": {
    "desc": "RS Bridge pellet feeder, listens for reactor_sensor",
    "deps": [
      "cn_lib"
    ],
    "config": [
      {
        "key": "ReactorName",
        "prompt": "Reactor name (same on sensor + RS computer)"
      },
      {
        "key": "ExportDir",
        "prompt": "Bridge side facing the fuel port",
        "default": "down"
      },
      {
        "key": "Pellet",
        "prompt": "Pellet item id",
        "default": "oritech:uranium_pellet"
      },
      {
        "key": "Batch",
        "prompt": "Pellets per export",
        "default": "8"
      },
      {
        "key": "Stock",
        "prompt": "Craft when RS holds fewer than",
        "default": "8"
      },
      {
        "key": "CraftBatch",
        "prompt": "Pellets per craft request",
        "default": "64"
      }
    ],
    "files": [
      "programs/reactor_rs.lua"
    ],
    "main": "programs/reactor_rs.lua"
  },
  "reactor_sensor": {
    "desc": "Oritech reactor redstone port -> rednet gate broadcast",
    "deps": [
      "cn_lib"
    ],
    "config": [
      {
        "key": "ReactorName",
        "prompt": "Reactor name (same on sensor + RS computer)"
      },
      {
        "key": "InSide",
        "prompt": "Side touching redstone port comparator",
        "default": "back"
      },
      {
        "key": "OpenBelow",
        "prompt": "Gate opens (fuel allowed) when signal is below this, 1 = only when empty",
        "default": "1"
      }
    ],
    "files": [
      "programs/reactor_sensor.lua"
    ],
    "main": "programs/reactor_sensor.lua"
  }
}
